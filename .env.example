# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# mock (default): zero API calls, zero cost, no key required - app.mock_llm.MockAnthropicClient.
# live: the real Anthropic client, real cost. Prefer overriding per-command (e.g.
# `make eval-fast-live`) over setting this to "live" here, so nothing runs live by accident.
APP_LLM_MODE=mock
# Hard caps for any single agent run - guesses until validated against a real live run, see
# evals/thresholds.yaml's comment.
APP_MAX_STEPS=12
# Anthropic dollars only. Estimated provider dollars have their own cap below.
APP_MAX_COST_USD=0.25
# Estimated provider dollars (Serper/SerpApi calls at the APP_*_USD settings). Separate from the
# Anthropic cap above, so assumed provider prices cannot eat the model budget (or the reverse).
APP_MAX_PROVIDER_COST_USD=0.30
# Model per pipeline stage (configuration, never hardcoded in logic). Verified against
# https://platform.claude.com/docs/en/about-claude/models/overview on 2026-10-18.
APP_MODEL_PERCEPTION=claude-sonnet-5-5
APP_MODEL_RETRIEVAL=claude-haiku-5-5
# Web search tool type for retrieval. The basic variant works on every model; the _20260209 and
# later variants add dynamic filtering (code execution under the hood) - compare them live.
APP_WEB_SEARCH_TOOL=web_search_20250305
# Max searches the retrieval stage may run per furniture slot
APP_MAX_SEARCHES_PER_SLOT=3
# Max long edge (px) for photos after prepare_image; image tokens scale with size
APP_IMAGE_MAX_EDGE=1568
# SDK retries for expensive live calls (a timed-out call can still be billed): keep low
APP_SDK_MAX_RETRIES=1
# Set to 1 to disable trace logging
APP_TRACING_DISABLED=0
# Slots (furniture items) retrieval searches for, when --slots isn't passed
APP_DEFAULT_SLOTS=3
# Per-search cost estimate in USD (the API returns no dollar figure); default is pricing.py's value
# APP_WEB_SEARCH_USD=0.01
# Thinking effort per stage (low|medium|high|xhigh|max). Starting guesses, to be explored live:
# thinking tokens bill as output tokens.
APP_EFFORT_PERCEPTION=medium
APP_EFFORT_RETRIEVAL=low

# ---- Retrieval (ADR 0005) ----
# shopping (default): structured Google Shopping data; a model only picks finalist ids, and prices
# and URLs always come from the provider. web_search: Claude's web search tool reads pages.
APP_RETRIEVAL_MODE=shopping
# Search provider for stage 1: serper (default) or serpapi. Product lookups (stage 3) are always
# SerpApi google_product, so live shopping runs need SERPAPI_API_KEY either way.
APP_SEARCH_PROVIDER=serper
# Finalists the rank stage may pick per slot (each costs one lookup)
APP_FINALISTS_PER_SLOT=2
# Model for the rank stage; unset means the same model as APP_MODEL_RETRIEVAL
# APP_MODEL_RANK=
# Provider keys. Never commit, never paste into logs.
SERPER_API_KEY=
SERPAPI_API_KEY=
# Dollar estimates per provider call. These two defaults are ASSUMPTIONS: set them from your actual
# plan (Serper bills 2 credits per shopping query; SerpApi bills per search). On a free tier the
# real cost is $0; the estimate still counts toward APP_MAX_PROVIDER_COST_USD so a run stays bounded.
APP_SERPER_USD_PER_QUERY=0.0006
APP_SERPAPI_USD_PER_SEARCH=0.025

# ---- Proposal and self-check (ADR 0006) ----
# One structured call picks the final list; a text-only call checks style.
APP_MODEL_PROPOSAL=claude-sonnet-5-5
APP_EFFORT_PROPOSAL=low
APP_MODEL_STYLECHECK=claude-haiku-5-5
APP_EFFORT_STYLECHECK=low
# Automatic revisions after a failed check (0 disables). Remaining failures are shown as warnings.
APP_MAX_REVISIONS=1
# No single item's total may exceed this fraction of the budget (unless it is the only item).
# Untuned guess, like the fit constants in config.py.
APP_ITEM_CAP_FRACTION=0.6
# Per-item search ceiling = budget * APP_ITEM_CAP_FRACTION / (1 + APP_SHIPPING_BUFFER); the buffer
# leaves room for shipping, which search results do not show. Untuned guess.
APP_SHIPPING_BUFFER=0.10

# ---- Freeplay mode (no --budget; ADR 0008) ----
# Results driven by style, quality and a coarse price tier instead of a budget.
# Price tier for freeplay: value | mid | premium (cheapest third / middle third / top third of
# the search results for each slot). The CLI flag --price-tier overrides it; combining it with
# --budget is an error.
APP_PRICE_TIER=mid
# Pieces to shop for when --items is not given: 5 in freeplay (APP_DEFAULT_SLOTS=3 in budget mode)
APP_DEFAULT_ITEMS_FREEPLAY=5
# Hard maximum for --items (the minimum is 2)
APP_MAX_ITEMS=10
# Product lookups per slot (each is roughly one SerpApi search, about $0.025 estimated). Unset =
# 1 in freeplay (the top-ranked finalist; the next is tried if it fails) and 2 in budget mode.
# APP_LOOKUPS_PER_SLOT=1

# ---- Image-based style check (ADR 0010) ----
# 1 (default): fetch one product thumbnail per slot (https only, public hosts, 3 s, 1 MB) and show
# it to the style check with the room photo. 0: text-only style check (no image fetches at all).
APP_THUMBNAILS=1

# ---- Photo-real spike (scripts/render_spike.py, an experiment; names only, never commit values) ----
# Only the providers you want to test live. Mock runs need none of them.
OPENAI_API_KEY=
GEMINI_API_KEY=
DECOR8_API_KEY=
# OpenAI's image model id and price are NOT verified in this repo: set them yourself before a live
# gpt run (see docs/sessions/2026-10-23-photo-real-spike.md).
# RENDER_OPENAI_MODEL=
# RENDER_OPENAI_USD_PER_IMAGE=

# ---- Shop Mode (ADR 0012) ----
# Link lookups (about one SerpApi search each) allowed per session; spent only on Open or Love.
# APP_SHOP_LOOKUPS_PER_SESSION=12
# Shop Again uses per session (each runs a preference call, a rank call and up to 3 Serper pages).
# APP_SHOP_AGAINS_PER_SESSION=10
# Serper calls one Shop Again may make (up to 3 search phrasings, extra pages while the pool is thin).
# APP_SHOP_AGAIN_MAX_SERPER_CALLS=4
# The most Serper calls one Shop Again may make in all: its phrasings (the cap above), up to 3 peer
# retailer searches, and targeted searches for a thin open value. Must be at least the cap above.
# APP_SHOP_AGAIN_MAX_SERPER_CALLS_TOTAL=9
# Serper bills credits: a shopping call took 2 credits in a live test. Shop Mode's cost estimate is
# calls x credits per call x USD per credit.
# APP_SERPER_CREDITS_PER_CALL=2
# APP_SERPER_USD_PER_CREDIT=0.001
