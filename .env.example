# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# mock (default): zero API calls, zero cost, no key required - app.mock_llm.MockAnthropicClient.
# live: the real Anthropic client, real cost. Prefer overriding per-command (e.g.
# `make eval-fast-live`) over setting this to "live" here, so nothing runs live by accident.
APP_LLM_MODE=mock
# Hard caps for any single agent run - guesses until validated against a real live run, see
# evals/thresholds.yaml's comment.
APP_MAX_STEPS=12
APP_MAX_COST_USD=0.25
# Model per pipeline stage (configuration, never hardcoded in logic). Verified against
# https://platform.claude.com/docs/en/about-claude/models/overview on 2026-10-18.
APP_MODEL_PERCEPTION=claude-sonnet-5-5
APP_MODEL_RETRIEVAL=claude-haiku-5-5
# Web search tool type for retrieval. The basic variant works on every model; the _20260209 and
# later variants add dynamic filtering (code execution under the hood) - compare them live.
APP_WEB_SEARCH_TOOL=web_search_20250305
# Max searches the retrieval stage may run per furniture slot
APP_MAX_SEARCHES_PER_SLOT=3
# Max long edge (px) for photos after prepare_image; image tokens scale with size
APP_IMAGE_MAX_EDGE=1568
# SDK retries for expensive live calls (a timed-out call can still be billed): keep low
APP_SDK_MAX_RETRIES=1
# Set to 1 to disable trace logging
APP_TRACING_DISABLED=0
